<!-- TAB 5: PERSISTENT WORKER POOL & DAEMON                               -->
<!-- ==================================================================== -->
@if (_activeTab == "workers")
{
    <div class="d-flex flex-column gap-6">
        <div class="d-flex flex-column flex-sm-row justify-space-between align-start align-sm-center gap-3">
            <div>
                <MudText Typo="Typo.subtitle1" Class="font-weight-bold" Style="color: #f8fafc;">
                    Persistent Worker Pool Management
                </MudText>
                <MudText Typo="Typo.body2" Style="color: #64748b;">
                    Warm background CLI processes maintaining open streaming channels. Eliminates terminal flashing and cuts turn latency down to ~3s.
                </MudText>
            </div>

            <div class="d-flex align-center gap-2">
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Warning"
                           StartIcon="@Icons.Material.Filled.RestartAlt"
                           OnClick="RecyclePoolAsync"
                           Style="font-weight: 600; text-transform: none; border-radius: 8px;">
                    Recycle Worker Pool
                </MudButton>
            </div>
        </div>

        <!-- Worker Pool Metrics -->
        <MudGrid Spacing="2">
            <MudItem xs="6" sm="3">
                <div class="metric-tile">
                    <span style="color: #94a3b8; font-size: 0.72rem; font-weight: 600; text-transform: uppercase;">Total Workers</span>
                    <div style="font-size: 1.5rem; font-weight: 700; color: #f8fafc; font-family: var(--font-mono);">
                        @(_poolStats?.TotalWorkers ?? 0)
                    </div>
                    <div style="font-size: 0.7rem; color: #94a3b8; margin-top: 4px;">
                        Active: <strong style="color: #38bdf8;">@(_poolStats?.ActiveWorkers ?? 0)</strong> · Idle: <strong style="color: #34d399;">@(_poolStats?.IdleWorkers ?? 0)</strong>
                    </div>
                </div>
            </MudItem>

            <MudItem xs="6" sm="3">
                <div class="metric-tile">
                    <span style="color: #94a3b8; font-size: 0.72rem; font-weight: 600; text-transform: uppercase;">Pool Memory (RAM)</span>
                    <div style="font-size: 1.5rem; font-weight: 700; color: #f8fafc; font-family: var(--font-mono);">
                        @(((_poolStats?.TotalWorkingSetBytes ?? 0) / (1024.0 * 1024.0)).ToString("F1")) MB
                    </div>
                    <div style="font-size: 0.7rem; color: #94a3b8; margin-top: 4px;">
                        Total Working Set
                    </div>
                </div>
            </MudItem>

            <MudItem xs="6" sm="3">
                <div class="metric-tile">
                    <span style="color: #94a3b8; font-size: 0.72rem; font-weight: 600; text-transform: uppercase;">Turns Served</span>
                    <div style="font-size: 1.5rem; font-weight: 700; color: #f8fafc; font-family: var(--font-mono);">
                        @(_poolStats?.TotalTurnsCompleted ?? 0)
                    </div>
                    <div style="font-size: 0.7rem; color: #94a3b8; margin-top: 4px;">
                        Zero Process Restarts
                    </div>
                </div>
            </MudItem>

            <MudItem xs="6" sm="3">
                <div class="metric-tile">
                    <span style="color: #94a3b8; font-size: 0.72rem; font-weight: 600; text-transform: uppercase;">Protocol</span>
                    <div style="font-size: 1.5rem; font-weight: 700; color: #34d399; font-family: var(--font-mono);">
                        NDJSON
                    </div>
                    <div style="font-size: 0.7rem; color: #94a3b8; margin-top: 4px;">
                        Hidden Process Subsystem
                    </div>
                </div>
            </MudItem>
        </MudGrid>

        <!-- Active Workers Table -->
        <MudTable Items="@(_poolStats?.Workers ?? Array.Empty<AgyWorkerInfo>())" Elevation="0" Class="dashboard-table" Hover="true">
            <HeaderContent>
                <MudTh>Worker ID</MudTh>
                <MudTh>PID</MudTh>
                <MudTh>Model</MudTh>
                <MudTh>Status</MudTh>
                <MudTh>Turns</MudTh>
                <MudTh>Memory (RAM)</MudTh>
                <MudTh>Last Active</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Worker ID">
                    <strong style="color: #f8fafc; font-family: var(--font-mono);">@context.Id</strong>
                </MudTd>
                <MudTd DataLabel="PID">
                    <span class="token-badge" style="font-family: var(--font-mono);">@context.ProcessId</span>
                </MudTd>
                <MudTd DataLabel="Model">
                    <span style="color: #94a3b8; font-size: 0.8rem;">@context.Model (@context.Effort)</span>
                </MudTd>
                <MudTd DataLabel="Status">
                    @if (context.IsBusy)
                    {
                        <span class="token-badge token-badge-purple">
                            <span class="pulse-dot" style="width: 5px; height: 5px;"></span> Streaming
                        </span>
                    }
                    else if (context.IsHealthy)
                    {
                        <span class="token-badge token-badge-success">
                            <span class="pulse-dot" style="width: 5px; height: 5px;"></span> Warm Idle
                        </span>
                    }
                    else
                    {
                        <span class="token-badge token-badge-amber">Dead</span>
                    }
                </MudTd>
                <MudTd DataLabel="Turns">
                    <span style="font-family: var(--font-mono); color: #cbd5e1;">@context.TurnCount</span>
                </MudTd>
                <MudTd DataLabel="Memory">
                    <span style="font-family: var(--font-mono); color: #cbd5e1;">@((context.WorkingSetBytes / (1024.0 * 1024.0)).ToString("F1")) MB</span>
                </MudTd>
                <MudTd DataLabel="Last Active">
                    <span style="font-size: 0.75rem; color: #64748b;">@context.LastActiveUtc.ToLocalTime().ToString("HH:mm:ss")</span>
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText Typo="Typo.body2" Class="pa-4 text-center" Style="color: #64748b;">
                    No workers currently active in pool.
                </MudText>
            </NoRecordsContent>
        </MudTable>
    </div>
}

@code {
    private List<string> _models = [];
    private List<ApiKeyItem> _keys = [];
    private AgyPoolStats? _poolStats;
    private string _selectedModel = "gemini-3.8-flash-high";
    private bool _enableAgentic = false;

    // Navigation and filters
    private string _activeTab = "keys";
    private string _keySearchText = "";
    private string _modelSearchText = "";
    private string _selectedKeyForSnippet = "YOUR_API_KEY";

    // Playground state
    private string _promptText = "";
    private bool _isStreaming = false;
    private string _streamingDelta = "";
    private List<ChatMessage> _chatMessages = [];
    private AgyUsage? _lastUsage;

    // KPI sums
    private long TotalTokensAcrossKeys => _keys.Sum(k => k.TotalTokens);
    private long TotalPromptTokens => _keys.Sum(k => k.PromptTokens);
    private long TotalCompletionTokens => _keys.Sum(k => k.CompletionTokens);
    private long TotalRequestsAcrossKeys => _keys.Sum(k => k.RequestCount);

    private readonly string[] _paletteColors = ["#38bdf8", "#818cf8", "#34d399", "#fbbf24", "#f43f5e", "#a78bfa"];

    private IEnumerable<(ApiKeyItem Key, string Color)> KeyColorPairs =>
        _keys.Select((k, idx) => (k, _paletteColors[idx % _paletteColors.Length]));

    private IEnumerable<ApiKeyItem> FilteredKeys =>
        string.IsNullOrWhiteSpace(_keySearchText)
            ? _keys
            : _keys.Where(k => k.Name.Contains(_keySearchText, StringComparison.OrdinalIgnoreCase) ||
                               k.MaskedKey.Contains(_keySearchText, StringComparison.OrdinalIgnoreCase) ||
                               k.Id.Contains(_keySearchText, StringComparison.OrdinalIgnoreCase));

    private IEnumerable<string> FilteredModels =>
        string.IsNullOrWhiteSpace(_modelSearchText)
            ? _models
            : _models.Where(m => m.Contains(_modelSearchText, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        await ModelRegistry.InitializeAsync();
        _models = ModelRegistry.GetDiscoveredModels().ToList();
        if (_models.Count > 0 && !_models.Contains(_selectedModel))
        {
            _selectedModel = _models[0];
        }

        await ApiKeyManager.InitializeAsync();
        _keys = (await ApiKeyManager.GetKeysAsync()).ToList();
        _poolStats = WorkerPool.GetStats();
    }

    private async Task RecyclePoolAsync()
    {
        try
        {
            await WorkerPool.RecycleAllAsync();
            _poolStats = WorkerPool.GetStats();
            Snackbar.Add("Worker pool successfully recycled! Standby workers ready.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Recycle failed: {ex.Message}", Severity.Error);
        }
    }

    private async Task OpenCreateKeyDialog()
    {
        var dialog = await DialogService.ShowAsync<Components.Dialogs.CreateKeyDialog>("Create New API Key");
        var result = await dialog.Result;
        if (result != null && !result.Canceled)
        {
            await LoadDataAsync();
        }
    }

    private async Task ResetKeyUsage(string id, string name)
    {
        bool? confirmed = await DialogService.ShowMessageBoxAsync(
            "Reset Token Telemetry",
            $"Are you sure you want to reset all token counters and request count for '{name}' to 0?",
            yesText: "Reset Usage", cancelText: "Cancel");

        if (confirmed == true)
        {
            await ApiKeyManager.ResetUsageAsync(id);
            Snackbar.Add($"Token usage reset for '{name}'.", Severity.Info);
            await LoadDataAsync();
        }
    }

    private async Task RevokeKey(string id, string name)
    {
        bool? confirmed = await DialogService.ShowMessageBoxAsync(
            "Revoke Key",
            $"Are you sure you want to revoke '{name}'? Any connected applications will immediately be denied access.",
            yesText: "Revoke Key", cancelText: "Cancel");

        if (confirmed == true)
        {
            await ApiKeyManager.RevokeKeyAsync(id);
            Snackbar.Add($"Key '{name}' revoked.", Severity.Warning);
            await LoadDataAsync();
        }
    }

    private void SwitchToPlaygroundWithModel(string model)
    {
        _selectedModel = model;
        _activeTab = "playground";
        Snackbar.Add($"Switched to Playground with '{model}'", Severity.Info);
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey && !_isStreaming && !string.IsNullOrWhiteSpace(_promptText))
        {
            await SendChatPrompt();
        }
    }

    private async Task SendChatPrompt()
    {
        var text = _promptText.Trim();
        if (string.IsNullOrWhiteSpace(text) || _isStreaming) return;

        _promptText = "";
        _chatMessages.Add(new ChatMessage { Role = "user", Content = text });
        _isStreaming = true;
        _streamingDelta = "";

        try
        {
            var req = new AgyExecutionRequest
            {
                Prompt = text,
                Model = _selectedModel,
                EnableAgenticMode = _enableAgentic
            };

            await foreach (var item in AgyProcess.ExecutePromptStreamAsync(req))
            {
                if (!string.IsNullOrEmpty(item.TextDelta))
                {
                    _streamingDelta += item.TextDelta;
                    await InvokeAsync(StateHasChanged);
                }

                if (item.Usage != null)
                {
                    _lastUsage = item.Usage;
                }
            }

            _chatMessages.Add(new ChatMessage { Role = "assistant", Content = _streamingDelta });
            _streamingDelta = "";
        }
        catch (Exception ex)
        {
            _chatMessages.Add(new ChatMessage { Role = "assistant", Content = $"Error: {ex.Message}" });
            Snackbar.Add($"AGY Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isStreaming = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void ClearChat()
    {
        _chatMessages.Clear();
        _streamingDelta = "";
        _lastUsage = null;
    }

    private async Task CopyText(string text, string msg)
    {
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", text);
        Snackbar.Add(msg, Severity.Info);
    }

    private static string FormatTokens(long tokens)
    {
        if (tokens >= 1_000_000)
            return $"{tokens / 1_000_000.0:0.0}M";
        if (tokens >= 1_000)
            return $"{tokens / 1_000.0:0.0}k";
        return tokens.ToString("N0");
    }

    private static string GetRelativeTime(DateTime? dtUtc)
    {
        if (!dtUtc.HasValue) return "Never";
        var diff = DateTime.UtcNow - dtUtc.Value;
        if (diff.TotalSeconds < 60) return "Just now";
        if (diff.TotalMinutes < 60) return $"{(int)diff.TotalMinutes}m ago";
        if (diff.TotalHours < 24) return $"{(int)diff.TotalHours}h ago";
        if (diff.TotalDays < 7) return $"{(int)diff.TotalDays}d ago";
        return dtUtc.Value.ToLocalTime().ToString("MMM dd");
    }

