{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Agy": {
    "BindAddress": "127.0.0.1",
    "Port": 5200,
    "ExecutablePath": "agy",
    "DefaultModel": "gemini-3.8-flash-medium",
    "WorkspaceDirectory": "./workspace",
    "AllowAgenticTools": false,
    "IncludeReasoningContent": true,
    "ReasoningFormat": "field",
    "DefaultReasoningEffort": "medium",
    "EnableThinkingDirectives": true,
    "EmitLegacyReasoningField": false,
    "ApiKey": "",
    "AdminApiKey": "",
    "AllowedCorsOrigins": [],
    "DatabasePath": "data/agy_gateway.db",
    "EnableWorkerPool": true,
    "MaxPoolSize": 3,
    "WorkerIdleTimeoutMinutes": 10,
    "MaxTurnsPerWorker": 50,
    "WarmWorkersOnStartup": 1,
    "PoolAcquireTimeoutSeconds": 60,
    "PrintTimeoutMinutes": 30,
    "StreamKeepAliveSeconds": 15
  }
}
